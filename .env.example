# ---- All core providers work with NO key. Everything below is optional. ----

# Solana RPC. The public endpoint is heavily rate-limited; a free Helius/QuickNode
# URL makes `watch` mode usable at short intervals.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: X/Twitter API v2 bearer token. Without it the social layer runs off
# the curated roster in data/whales.json and reports UNAVAILABLE for live search
# rather than guessing. See README "Social attribution".
X_BEARER_TOKEN=

# Dashboard port
PORT=8787

# Safety thresholds (see src/config.ts for the full list and defaults)
SAFETY_MAX_TOP_HOLDER_PCT=25
SAFETY_MAX_SELL_TAX_PCT=15
SAFETY_MIN_LP_LOCKED_PCT=90
SAFETY_MAX_DATA_AGE_SEC=300
